{
  "name": "@cortex/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "CORTEX_INTEGRATION_TESTS=true vitest run test/integration"
  },
  "dependencies": {
    "@cortex/canonical-schema": "workspace:*",
    "@cortex/observability": "workspace:*",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/kms": "^4.5.0",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "pg": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^22.0.0"
  }
}
