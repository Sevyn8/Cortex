# Cortex — developer environment variables.
# Copy to .env.local (gitignored) and fill in secret placeholders.
# Secrets are fetched from Bitwarden or GCP Secret Manager — never commit real values.

# ─────────────────────────────────────────────────────────────────────────────
# Core runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# GCP (dev project identity; local services use emulators below)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=cortex-dev
GCP_REGION=asia-south1
GCP_REGION_DR=asia-south2

# ─────────────────────────────────────────────────────────────────────────────
# Local emulators (docker compose)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex_dev
REDIS_URL=redis://localhost:6379

# Google Cloud SDK honors this automatically for Pub/Sub
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=cortex-dev-local

# GCS fake — clients must explicitly set api_endpoint to this URL
STORAGE_EMULATOR_HOST=http://localhost:4443
GCS_BUCKET_PREFIX=cortex-dev

# ─────────────────────────────────────────────────────────────────────────────
# Third-party providers (AC01 auth, A05 LLM, P5.20 email)
# Placeholders — fetch from Bitwarden / GCP Secret Manager.
# ─────────────────────────────────────────────────────────────────────────────

# WorkOS (AC01 — AuthKit)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# 32+ chars. Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Anthropic (A05 LLM Gateway)
ANTHROPIC_API_KEY=

# Resend (P5.20 transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=dev@cortex.local

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags (F04 / feature-flags service)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated key=value overrides for local-only flag values
FEATURE_FLAGS_OVERRIDE=
